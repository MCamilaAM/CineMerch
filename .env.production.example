# Copia estas variables al proveedor. El volumen se monta durante el arranque.
# En Railway, monta un volumen en /data y usa una sola réplica.
DATABASE_URL="file:/data/cinemerch.db"
PORT="3000"
NEXT_PUBLIC_SITE_URL="https://tu-dominio.example"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""
CINEMERCH_PRIVACY_EMAIL=""
TMDB_API_KEY=""
RESEND_API_KEY=""
ADMIN_ACCESS_TOKEN="reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres"
# El proyecto conserva la pasarela simulada. No procesa cobros reales.
# Activa true solo si vas a publicar explícitamente la demo académica.
PAYMENT_PROVIDER="WOMPI_SIMULATED"
PAYMENT_SIMULATION_ENABLED="false"
MOCK_WOMPI_EVENT_SECRET="reemplazar-con-otro-secreto-aleatorio-independiente"
